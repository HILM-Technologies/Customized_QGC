{
  "configurations": [
    {
      "name": "Launch HILMGroundControl (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/HILMGroundControl.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/Debug",
      "environment": [
        {
          "name": "QT_QPA_PLATFORM",
          "value": "windows"
        },
        {
          "name": "QML_IMPORT_TRACE",
          "value": "0"
        },
        {
          "name": "QML_IMPORT_PATH",
          "value": "${workspaceFolder}/build/qml"
        }
      ],
      "externalConsole": false,
      "preLaunchTask": "CMake: Build"
    },
    {
      "name": "Launch HILMGroundControl (Release)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Release/HILMGroundControl.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/Release",
      "environment": [
        {
          "name": "QT_QPA_PLATFORM",
          "value": "windows"
        },
        {
          "name": "QML_IMPORT_TRACE",
          "value": "0"
        },
        {
          "name": "QML_IMPORT_PATH",
          "value": "${workspaceFolder}/build/qml"
        }
      ],
      "externalConsole": false
    },
    {
      "name": "Run Unit Tests (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/HILMGroundControl.exe",
      "args": ["--unittest"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/Debug",
      "environment": [],
      "externalConsole": false,
      "preLaunchTask": "CMake: Build"
    },
    {
      "name": "Debug Specific Test",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/HILMGroundControl.exe",
      "args": ["--unittest:${input:testClass}"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/Debug",
      "environment": [],
      "externalConsole": false,
      "preLaunchTask": "CMake: Build"
    },
    {
      "name": "Attach to HILMGroundControl",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "program": "${workspaceFolder}/build/Debug/HILMGroundControl.exe"
    }
  ],
  "inputs": [
    {
      "description": "Test class name (e.g., FactSystemTest)",
      "id": "testClass",
      "type": "promptString"
    }
  ],
  "version": "0.2.0"
}
